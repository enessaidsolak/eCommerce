@model OrderSuccessViewModel

<div class="container py-5 text-center" style="margin-top:100px;">
    <h2 class="text-success">🎉 Siparişiniz Başarıyla Tamamlandı</h2>

    <p><strong>Sipariş Numaranız:</strong> @Model.OrderId</p>
    <p><strong>Tarih:</strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
    <p><strong>Toplam Tutar:</strong> @Model.TotalAmount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</p>
    <p><strong>Adres:</strong> @Model.Address</p>

    <h4 class="mt-4">Sipariş Özeti</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Ürün</th>
                <th>Adet</th>
                <th>Birim Fiyat</th>
                <th>Toplam</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td>
                        <img src="@item.ImageUrl"
                             style="width:60px;height:60px;object-fit:cover;" />
                        @item.Name
                    </td>
                    <td>@item.Quantity</td>
                    <td>@(item.Price.ToString("C", new System.Globalization.CultureInfo("tr-TR")))</td>
                    <td>@((item.Price * item.Quantity).ToString("C", new System.Globalization.CultureInfo("tr-TR")))</td>
                </tr>
            }

        </tbody>
    </table>

    <div class="mt-4">
        <a href="/" class="btn btn-primary">🛒 Alışverişe Devam Et</a>
    </div>
</div>
