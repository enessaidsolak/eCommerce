@model eCommerce.WEB.Models.CheckoutViewModel
@using eCommerce.WEB.Models

<!-- Page Header Start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Ödeme</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Anasayfa</a></li>
        <li class="breadcrumb-item"><a href="#">Sayfalar</a></li>
        <li class="breadcrumb-item active text-white">Ödeme</li>
    </ol>
</div>
<!-- Page Header End -->

<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Fatura Ayrıntıları</h1>

        <form asp-action="PlaceOrder" method="post">
            <div class="row g-5">
                <!-- Sol: Adres -->
                <div class="col-md-12 col-lg-6 col-xl-7">
                  @if (Model.SavedAddresses != null)  
{
    <label for="SelectedAddressId" class="form-label">Adresinizi Seçin veya Yeni Adres Ekleyin</label>
    <div class="d-flex mb-3">
        <select asp-for="SelectedAddressId" class="form-select" id="SelectedAddressId">
            <option value="0">Yeni Adres Ekle</option>
            @foreach (var a in Model.SavedAddresses)
            {
                <option value="@a.Id">@a.FullName - @a.AddressLine, @a.City</option>
            }
        </select>
        <button type="button" class="btn btn-danger ms-2" id="deleteAddressBtn">Sil</button>
        <button type="button" class="btn btn-success ms-2" id="addAddressBtn">Kaydet</button>
    </div>
}


                    <div id="addressFormFields">
                        <input asp-for="FirstName" class="form-control mb-3" placeholder="Ad" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>

                        <input asp-for="LastName" class="form-control mb-3" placeholder="Soyad" />
                        <span asp-validation-for="LastName" class="text-danger"></span>

                        <input asp-for="CompanyName" class="form-control mb-3" placeholder="Firma Adı" />

                        <input asp-for="AddressLine" class="form-control mb-3" placeholder="Adres" />
                        <span asp-validation-for="AddressLine" class="text-danger"></span>

                        <input asp-for="City" class="form-control mb-3" placeholder="Kasaba/Şehir" />
                        <span asp-validation-for="City" class="text-danger"></span>

                        <input asp-for="Country" class="form-control mb-3" placeholder="Ülke" />
                        <span asp-validation-for="Country" class="text-danger"></span>

                        <input asp-for="Postcode" class="form-control mb-3" placeholder="Posta Kodu" />
                        <span asp-validation-for="Postcode" class="text-danger"></span>

                        <input asp-for="Mobile" class="form-control mb-3" placeholder="Telefon Numarası" />
                        <span asp-validation-for="Mobile" class="text-danger"></span>

                        <input asp-for="Email" class="form-control mb-3" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <textarea asp-for="OrderNotes" class="form-control mb-3" placeholder="Sipariş Notları (İsteğe Bağlı)" data-val="false"></textarea>

                </div>

                <!-- Sağ: Sepet ve Ödeme -->
                <div class="col-md-12 col-lg-6 col-xl-5">
                    <div class="table-responsive mb-4">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Ürün</th>
                                    <th>İsim</th>
                                    <th>Fiyat</th>
                                    <th>Adet</th>
                                    <th>Toplam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td><img src="@item.ImageUrl" style="width:80px;height:80px;object-fit:cover;" /></td>
                                        <td>@item.Name</td>
                                        <td>@(item.Price.ToString("C", new System.Globalization.CultureInfo("tr-TR")))</td>
                                        <td>@item.Quantity</td>
                                        <td>@((item.Price * item.Quantity).ToString("C", new System.Globalization.CultureInfo("tr-TR")))</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4">Ara Toplam</td>
                                    <td>@(Model.Subtotal.ToString("C", new System.Globalization.CultureInfo("tr-TR")))</td>
                                </tr>
                                <tr>
                                    <td colspan="4">Kargo</td>
                                    <td>@(Model.ShippingCost.ToString("C", new System.Globalization.CultureInfo("tr-TR")))</td>
                                </tr>
                                <tr>
                                    <td colspan="4"><strong>TOPLAM</strong></td>
                                    <td><strong>@(Model.Total.ToString("C", new System.Globalization.CultureInfo("tr-TR")))</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h5>Kargo Seçenekleri</h5>
                    <div class="form-check">
                        <input asp-for="ShippingOption" class="form-check-input" type="radio" value="FreeShipping" id="Shipping-1" checked />
                        <label class="form-check-label" for="Shipping-1">
                            @(Model.Subtotal >= 300 ? "300 TL Üzeri Ücretsiz Kargo" : "Kargo: 3,00 ₺")
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mt-3">Sipariş Ver</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Form doğrulama
            $("form[asp-action='PlaceOrder']").validate({
                highlight: function (element) { $(element).addClass('is-invalid'); },
                unhighlight: function (element) { $(element).removeClass('is-invalid'); },
                errorClass: 'text-danger',
                errorPlacement: function (error, element) { error.insertAfter(element); },
                ignore: "[name='OrderNotes']"
            });

            const select = document.getElementById('SelectedAddressId');
            const formFields = document.getElementById('addressFormFields');

            // Adres formunu göster/gizle
            if (select) {
                const toggleFields = () => { formFields.style.display = (select.value == "0") ? "block" : "none"; };
                toggleFields();
                select.addEventListener('change', toggleFields);
            }

            // Adres silme
            const deleteBtn = document.getElementById("deleteAddressBtn");
            if (deleteBtn) {
                deleteBtn.addEventListener("click", function () {
                    if (!select) return;
                    const addressId = select.value;
                    if (addressId == "0") { alert("Yeni adres seçili, silinemez!"); return; }
                    if (!confirm("Bu adresi silmek istediğinize emin misiniz?")) return;

                    fetch('/Checkout/DeleteAddress', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(addressId)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert("Adres silindi.");
                            const optionToRemove = select.querySelector(`option[value='${addressId}']`);
                            if(optionToRemove) optionToRemove.remove();
                            select.value = "0"; // Yeni adres eklemeye geç
                            formFields.style.display = "block";
                        } else {
                            alert(data.message || "Adres silinemedi!");
                        }
                    });
                });
            }

            // Adres ekleme
            const addBtn = document.getElementById("addAddressBtn");
            if (addBtn) {
                addBtn.addEventListener("click", function () {
                    const model = {
                        AddressLine: $("#AddressLine").val(),
                        City: $("#City").val(),
                        Country: $("#Country").val(),
                        Postcode: $("#Postcode").val(),
                        Mobile: $("#Mobile").val()
                    };

                    fetch('/Checkout/AddAddress', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(model)
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert("Adres kaydedildi.");
                            // Dropdown'a yeni adres ekle
                            const newOption = document.createElement("option");
                            newOption.value = data.id;
                            newOption.text = model.AddressLine + ", " + model.City;
                            select.appendChild(newOption);
                            select.value = data.id; // yeni adres seçili
                            formFields.style.display = "none"; // formu gizle
                        } else {
                            alert(data.message || "Adres kaydedilemedi!");
                        }
                    });
                });
            }
        });
    </script>
}

