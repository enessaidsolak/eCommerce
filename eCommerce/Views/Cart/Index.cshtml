@model List<CartItemModel>

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Sepet</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Anasayfa</a></li>
        <li class="breadcrumb-item"><a href="#">Sayfalar</a></li>
        <li class="breadcrumb-item active text-white">Sepet</li>
    </ol>
</div>
<!-- Single Page Header End -->

<!-- Cart Page Start -->
<div class="container-fluid py-5">
    <div class="container py-5">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Ürünler</th>
                        <th scope="col">Ürün Adı</th>
                        <th scope="col">Fiyat (₺)</th>
                        <th scope="col">Adet</th>
                        <th scope="col">Toplam Fiyat (₺)</th>
                        <th scope="col">Sil</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-product-id="@item.ProductId">
                            <th scope="row">
                                <div class="d-flex align-items-center">
                                    <a href="@Url.Action("Index", "Home", new { idOrName = item.ProductId })">
                                        <div class="fruite-img">
                                            <img src="/@item.ImageUrl" class="img-fluid w-100 rounded-top" style="height:150px; width:150px;" alt="@item.ProductName">
                                        </div>
                                    </a>
                                </div>
                            </th>
                            <td><p class="mb-0 mt-4">@item.Name</p></td>
                            <td><p class="mb-0 mt-4 price-text">@item.Price.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</p></td>
                            <td>
                                <div class="input-group quantity mt-4" style="width: 100px;" data-product-id="@item.ProductId">
                                    <div class="input-group-btn">
                                        <button class="btn btn-sm btn-minus rounded-circle bg-light border" data-id="@item.ProductId">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                    </div>
                                    <input type="text" class="form-control form-control-sm text-center border-0 quantity-input" value="@item.Quantity" data-id="@item.ProductId" />
                                    <div class="input-group-btn">
                                        <button class="btn btn-sm btn-plus rounded-circle bg-light border" data-id="@item.ProductId">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <p class="mb-0 mt-4 item-total-price">
                                    @((item.Price * item.Quantity).ToString("C", new System.Globalization.CultureInfo("tr-TR")))
                                </p>
                            </td>
                            <td>
                                <button class="btn btn-md rounded-circle bg-light border mt-4 btn-remove-item" data-id="@item.ProductId" title="Remove item">
                                    <i class="fa fa-times text-danger"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Subtotal ve kargo hesaplama *@
        @{
            decimal subtotal = Model.Sum(x => x.Price * x.Quantity);
            decimal shipping = subtotal >= 300 ? 0 : 3;
            decimal discountAmount = ViewBag.DiscountAmount != null ? (decimal)ViewBag.DiscountAmount : 0;
            decimal totalAfterDiscount = subtotal - discountAmount + shipping;
        }

        <div class="mt-5">
            <form id="couponForm" method="post" asp-action="ApplyCoupon" asp-controller="Cart">
                <input type="text" id="couponCode" name="couponCode" class="border-0 border-bottom rounded me-2 py-3 mb-4" placeholder="Kupon Kodu" />
                <button class="btn border-secondary rounded-pill px-4 py-3 text-primary" type="submit">Kuponu Uygula</button>
            </form>
            <p id="couponMessage" class="text-danger">
                @if (!string.IsNullOrEmpty(ViewBag.CouponMessage as string))
                {
                    @ViewBag.CouponMessage
                }
            </p>
        </div>

        <div class="row g-4 justify-content-end">
            <div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
                <div class="bg-light rounded">
                    <div class="p-4">
                        <h1 class="display-6 mb-4">Sepet <span class="fw-normal">Toplamı</span></h1>

                        <!-- Subtotal -->
                        <div class="d-flex justify-content-between mb-2">
                            <h5 class="mb-0 me-4">Ara toplam:</h5>
                            <p class="mb-0 subtotal-price">@subtotal.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</p>
                        </div>

                        <!-- Discount (başlangıçta gizli) -->
                        <div class="d-flex justify-content-between mb-2 discount-row" style="display:none;">
                            <h5 class="mb-0 me-4">İndirim:</h5>
                            <p class="mb-0 text-success discount-amount">0 ₺</p>
                        </div>

                        <!-- Shipping -->
                        <div class="d-flex justify-content-between mb-2">
                            <h5 class="mb-0 me-4">Kargo Ücreti:</h5>
                            <p class="mb-0 shipping-price">@((shipping > 0) ? shipping.ToString("C", new System.Globalization.CultureInfo("tr-TR")) : "Ücretsiz")</p>
                        </div>
                        <p class="mb-0 text-end">Türkiyeye kargo.</p>
                    </div>

                    <div class="py-4 mb-4 border-top border-bottom d-flex justify-content-between">
                        <h5 class="mb-0 ps-4 me-4">Toplam</h5>
                        <p class="mb-0 total-price">@totalAfterDiscount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</p>
                    </div>

                    <button class="btn border-secondary rounded-pill px-4 py-3 text-primary text-uppercase mb-4 ms-4" 
                        type="button" 
                        onclick="location.href='@Url.Action("Index", "Checkout")'">
                        Ödeme işlemine devam et
                    </button>

                </div>
            </div>
        </div>

        <!-- JS -->
        <script>
            $(document).ready(function () {

                function parseCurrency(value) {
                    if (!value) return 0;
                    value = value.replace('₺', '').trim().replace(/\./g, '').replace(',', '.');
                    return parseFloat(value) || 0;
                }

                function formatCurrency(value) {
                    return value.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
                }

                function updateCartTotal() {
                    var subtotal = 0;
                    $('tbody tr').each(function () {
                        var totalText = $(this).find('.item-total-price').text();
                        subtotal += parseCurrency(totalText);
                    });

                    $('.subtotal-price').text(formatCurrency(subtotal));

                    var discount = parseCurrency($('.discount-amount').text()) || 0;

                    // Kargo hesaplama: 300 TL üzeri ücretsiz
                    var shippingCost = subtotal >= 300 ? 0 : 3;
                    $('.shipping-price').text(shippingCost > 0 ? formatCurrency(shippingCost) : "Ücretsiz");

                    var total = subtotal - discount + shippingCost;
                    $('.total-price').text(formatCurrency(total));
                }

                function handleBasketSize() {
                    $.ajax({
                        url: '/Cart/GetBasketSize',
                        type: 'GET',
                        success: function (size) {
                            var countElem = $('#cartItemCount');
                            if (size === 0) {
                                countElem.text(0).hide();
                                $('#cartPreview').html('<p>Sepetiniz boş</p>');
                            } else {
                                countElem.text(size).show();
                            }
                        }
                    });
                }

                function updateButtonsState() {
                    $('tbody tr').each(function () {
                        var quantityInput = $(this).find('.quantity-input');
                        var quantity = parseInt(quantityInput.val()) || 1;
                        var btnMinus = $(this).find('.btn-minus');
                        btnMinus.toggle(quantity > 1);
                    });
                }

                function removeItem(button) {
                    if (confirm("Bu ürünü sepetten kaldırmak istediğinize emin misiniz?")) {
                        var productId = $(button).data('id');
                        var container = $(button).closest('tr');
                        $.ajax({
                            url: '/Cart/RemoveFromCart',
                            type: 'POST',
                            data: { id: productId },
                            success: function (response) {
                                if (response.success) {
                                    container.remove();
                                    $('div[data-product-id="' + productId + '"]').remove();
                                    updateCartTotal();
                                    handleBasketSize();
                                    updateButtonsState();
                                }
                            }
                        });
                    }
                }

                $(document).on('click', '.btn-remove-item', function () {
                    removeItem(this);
                });

                // Kupon Formu Ajax Gönderimi
                $('#couponForm').submit(function (e) {
                    e.preventDefault();
                    var couponCode = $('#couponCode').val();
                    if (!couponCode) return;

                    $.ajax({
                        url: '/Cart/ApplyCouponAjax',
                        type: 'POST',
                        data: { couponCode: couponCode },
                        success: function (response) {
                            if (response.success) {
                                $('#couponMessage').text(response.message).removeClass('text-danger').addClass('text-success');
                                $('.discount-amount').text('-' + response.discountAmountFormatted);
                                $('.discount-row').show();
                            } else {
                                $('#couponMessage').text(response.message).removeClass('text-success').addClass('text-danger');
                                $('.discount-amount').text('0 ₺');
                                $('.discount-row').hide();
                            }

                            // Fiyatları güncelle
                            var subtotalParsed = parseFloat(response.subtotal.replace('₺','').replace('.','').replace(',','.'));
                            var discountParsed = parseFloat($('.discount-amount').text().replace('₺','').replace('.','').replace(',','.')) || 0;
                            var shippingCost = subtotalParsed >= 300 ? 0 : 3;
                            $('.shipping-price').text(shippingCost > 0 ? formatCurrency(shippingCost) : "Ücretsiz");

                            $('.subtotal-price').text(response.subtotalFormatted);
                            $('.total-price').text(formatCurrency(subtotalParsed - discountParsed + shippingCost));
                        },
                        error: function () {
                            $('#couponMessage').text('Kupon uygulanırken bir hata oluştu.').addClass('text-danger');
                        }
                    });
                });

            });
        </script>
