        <h1 class="fw-bold mb-0">İlgili Ürünler</h1>
<div class="vesitable">
    <div class="owl-carousel vegetable-carousel justify-content-center">
     
        @foreach (var item in Model.FeaturedProducts)
        {
            <div class="border border-primary rounded position-relative vesitable-item">
                <div class="vesitable-img">
                            <a href="@Url.Action("Details", "Product", new { idOrName = item.ProductId })">
                        <img src="/@item.ImageUrl" class="img-fluid w-100 rounded-top bg-light" alt="@item.ProductName">
                    </a>
                </div>
                <div class="text-white bg-primary px-3 py-1 rounded position-absolute" style="top: 10px; right: 10px;">Sebze</div>
                <div class="p-4 pb-0 rounded-bottom">
                    <h4>
                        <a href="/Product/Details/@item.ProductId" class="text-dark text-decoration-none">
                            @item.ProductName
                        </a>
                    </h4>
                    <p>@item.Description</p>
                    <div class="d-flex justify-content-between flex-lg-wrap">
                        <p class="text-dark fs-5 fw-bold">$7.99 / kg</p>
                        <a href="#" class="btn border border-secondary rounded-pill px-3 py-1 mb-4 text-primary">
                            <i class="fa fa-shopping-bag me-2 text-primary"></i> Sepete Ekle
