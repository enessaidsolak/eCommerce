@{
    ViewData["Title"] = "Contact";
}

<!-- Page Header Start (Shop ile aynı hizalama ve breadcrumb) -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">İletişim</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
        <li class="breadcrumb-item active text-white">İletişim</li>
    </ol>
</div>
<!-- Page Header End -->

<div class="container-fluid contact py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-4">

                <!-- Google Maps -->
                <div class="col-lg-12">
                    <div class="h-100 rounded mb-4">
                        <iframe class="rounded w-100" style="height: 400px; border:0;"
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3008.8909298186236!2d28.80622139204752!3d41.04951421588995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14caa503fb1ccf09%3A0x15e439c50228e786!2sT%C3%BCrkMedya!5e0!3m2!1sen!2sbd!4v1755248086263!5m2!1sen!2sbd"
                                allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>


                <div class="col-12 text-center mx-auto" style="max-width: 700px;">
                    <h1 class="text-primary">İletişime Geçin</h1>
                    <p class="mb-4">Aşağıdaki formu doldurarak bizimle iletişime geçmekten çekinmeyin.</p>
                </div>

                <div class="col-lg-7">
                    <form asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <input type="text" name="Name" class="w-100 form-control border-0 py-3 mb-4" placeholder="Adınız" required />
                        <input type="email" name="Email" class="w-100 form-control border-0 py-3 mb-4" placeholder="E-postanızı Girin" required />
                        <textarea name="Message" class="w-100 form-control border-0 mb-4" rows="5" placeholder="Mesajınız" required></textarea>
                        <button class="w-100 btn form-control border-secondary py-3 bg-white text-primary" type="submit">Gönder</button>
                    </form>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success text-center mt-3">@ViewBag.Message</div>
                    }
                </div>

                <div class="col-lg-5">
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-map-marker-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Adres</h4>
                            <p class="mb-2">Atatürk, Bahariye Cd. No:31, 34307 Küçükçekmece/İstanbul, Türkiye</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded mb-4 bg-white">
                        <i class="fas fa-envelope fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Bize mail gönderin</h4>
                            <p class="mb-2">eneszekiyun25@gmail.com</p>
                        </div>
                    </div>
                    <div class="d-flex p-4 rounded bg-white">
                        <i class="fa fa-phone-alt fa-2x text-primary me-4"></i>
                        <div>
                            <h4>Telefon</h4>
                            <p class="mb-2">0536 393 45 25</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
