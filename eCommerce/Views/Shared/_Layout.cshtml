    <script>
        window.addEventListener('load', function () {
            var spinner = document.getElementById('spinner');
            if (spinner) {
                spinner.classList.remove('show');
            }
        });
    </script>

    <script>
        function getCookie(name) {
            // debugger;
            let v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
            return v ? decodeURIComponent(v[2]) : null;
        }
        function showCart () {
             $("#showCart").toggleClass("show");
        }

        function loadCartPreview() {
            let cart = JSON.parse(getCookie('cart') || '[]');
            console.log("cart",cart)
            let container = $('#cartPreview');
            container.empty();

            if (cart.length === 0) {
                container.append('<p>Sepetiniz boş</p>');
                return;
            }

            cart.forEach(item => {
                container.append(`
                            <div class="d-flex align-items-center mb-2" data-product-id="${item.ProductId}" data-id="${item.ProductId}">
                                <img src="/${item.ImageUrl}" alt="${item.Name}" style="width:40px; height:40px; object-fit:cover; margin-right:10px; border-radius:4px;" />
                                <div>
                                    <p class="mb-0">${item.Name}</p>
                                    <small>Adet: ${item.Quantity}</small>
                                </div>
                                     <button class="btn btn-md rounded-circle bg-light border mt-4 btn-remove-item" onclick=" removeItem(this)" data-id="${item.ProductId}" title="Remove item">
                                    <i class="fa fa-times text-danger"></i>
                                </button>
                            </div>
                        `);
            });
        }
        function removeItem(button) { 
            if(confirm("Bu ürünü sepetten kaldırmak istediğinize emin misiniz?")) {
                var productId = $(button).data('id');

                // Table'daki tr
                var tableRow = $('tr[data-product-id="'+productId+'"]');

                // Dropdown'daki div (cart preview)
                var dropdownItem = $('div[data-product-id="'+productId+'"]');
                console.log("dropdownItem",dropdownItem)

                $.ajax({
                    url: '/Cart/RemoveFromCart',
                    type: 'POST',
                    data: { id: productId },
                    success: function(response) {
                        if(response.success){
                            tableRow.remove();       // Cart sayfasından kaldır
                            dropdownItem.remove();   // Dropdown’dan kaldır
                            updateCartTotal();
                            handleBasketSize();
                            updateButtonsState();
                        }
                    },
                    error: function() { 
                        alert("Silme işleminde hata oluştu."); 
                    }
                });
            }
        }


       
        function updateCartIcon() {
            let cart = JSON.parse(getCookie('cart') || '[]');
            let totalCount = 0;
            cart.forEach(item => totalCount += item.Quantity);
            let countSpan = document.getElementById('cartItemCount');
            if (countSpan) {
                countSpan.textContent = totalCount;
            }
        }

         // Cart sayfasındaki silme
  
        $(document).ready(function () {
            loadCartPreview();
            updateCartIcon();
            getCookie('cart');
        });
    </script>

    @RenderSection("Scripts", required: false)

    

<script>
    // Fonksiyonları global yap
    window.formatCurrency = function(value) {
        return value.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
    };

    window.parseCurrency = function(value) {
        value = value.replace('₺', '').trim().replace(/\./g, '').replace(',', '.');
        return parseFloat(value);
    };

    window.updateCartTotal = function() {
        var subtotal = 0;
        $('tbody tr').each(function () {
            var totalText = $(this).find('.item-total-price').text();
            subtotal += parseCurrency(totalText);
        });

        $('.subtotal-price').text(formatCurrency(subtotal));
        $('.total-price').text(formatCurrency(subtotal + 3)); // Kargo sabit ₺3
    };

    window.updateButtonsState = function() {
        $('tbody tr').each(function () {
            var quantityInput = $(this).find('.quantity-input');
            var quantity = parseInt(quantityInput.val()) || 1;
            var btnMinus = $(this).find('.btn-minus');
            if (quantity <= 1) btnMinus.hide();
            else btnMinus.show();
        });
    };

    window.handleBasketSize = function() {
        $.ajax({
            url: '/Cart/GetBasketSize',
            type: 'GET',
            success: function(size) {
                var countElem = $('#cartItemCount');
                if (size === 0) {
                    countElem.text(0).hide();
                    $('#cartPreview').html('<p>Sepetiniz boş</p>');
                } else {
                    countElem.text(size).show();
                }
            },
            error: function() {
                console.error("Sepet boyutu alınamadı.");
            }
        });
    };

    window.updateRowTotal = function(container, quantity) {
        var productRow = container.closest('tr');
        var priceText = productRow.find('.price-text').text();
        var price = parseCurrency(priceText);
        var totalPrice = price * quantity;
        productRow.find('.item-total-price').text(formatCurrency(totalPrice));
    };

    window.sendUpdateQuantity = function(productId, quantity, container) {
        $.ajax({
            url: '/Cart/UpdateQuantity',
            type: 'POST',
            data: { id: productId, quantity: quantity },
            success: function(response) {
                if (response.success) {
                    if (quantity === 0) {
                        container.closest('tr').remove();
                        $('div[data-product-id="'+productId+'"]').remove(); // Dropdown’dan da kaldır
                        updateCartTotal();
                    } else {
                        updateRowTotal(container, quantity);
                        updateCartTotal();
                    }

                    if (typeof updateCartIcon === "function") updateCartIcon();
                    if (typeof loadCartPreview === "function") loadCartPreview();
                } else {
                    alert("Ürün bulunamadı.");
                }
            },
            error: function() {
                alert("Bir hata oluştu.");
            }
        });
    };

    // Document ready
    $(function () {
        // Plus / Minus
       $('.btn-plus').off('click').on('click', function() {
    var container = $(this).closest('.input-group.quantity');
    var input = container.find('.quantity-input');
    var quantity = parseInt(input.val()) || 0;
    quantity += 1;
    input.val(quantity);

    var productId = $(this).data('id');

    // Sepette var mı diye kontrol et
    let cart = JSON.parse(getCookie('cart') || '[]');
    let item = cart.find(x => x.ProductId == productId);

    if(!item) {
        // Sepette yoksa önce AddToCart çağır
        $.post('/Cart/AddToCart', { id: productId }, function(res){
            if(res.success){
                sendUpdateQuantity(productId, quantity, container);
            } else {
                alert('Ürün sepete eklenemedi.');
            }
        });
    } else {
        sendUpdateQuantity(productId, quantity, container);
    }

    updateRowTotal(container, quantity);
    updateCartTotal();
    updateButtonsState();
});

// Eksi butonu
$('.btn-minus').off('click').on('click', function() {
    var container = $(this).closest('.input-group.quantity');
    var input = container.find('.quantity-input');
    var quantity = parseInt(input.val()) || 0;
    quantity = Math.max(0, quantity - 1);
    input.val(quantity);

    var productId = $(this).data('id');

    // Sepette var mı kontrol et
    let cart = JSON.parse(getCookie('cart') || '[]');
    let item = cart.find(x => x.ProductId == productId);

    if(!item && quantity > 0) {
        // Ürün sepette yok ve quantity > 0 ise önce ekle
        $.post('/Cart/AddToCart', { id: productId }, function(res){
            if(res.success){
                sendUpdateQuantity(productId, quantity, container);
            } else {
                alert('Ürün sepete eklenemedi.');
            }
        });
    } else {
        // Sepette varsa veya quantity 0 ise direkt güncelle
        sendUpdateQuantity(productId, quantity, container);
    }

    updateRowTotal(container, quantity);
    updateCartTotal();
    updateButtonsState();
});



      

        $('.quantity-input').off('change').on('change', function() {
            var input = $(this);
            var container = input.closest('.input-group.quantity');
            var quantity = parseInt(input.val());
            if (isNaN(quantity) || quantity < 1) quantity = 1;
            input.val(quantity);
            var productId = input.data('id');
            updateRowTotal(container, quantity);
            updateCartTotal();
            sendUpdateQuantity(productId, quantity, container);
            updateButtonsState();
        });

        $('.quantity-input').on('keydown', function(e) {
            var allowedKeys = [8, 9, 13, 37, 38, 39, 40, 46];
            if (
                allowedKeys.indexOf(e.keyCode) !== -1 ||
                (e.keyCode >= 48 && e.keyCode <= 57) ||
                (e.keyCode >= 96 && e.keyCode <= 105)
            ) return;
            else e.preventDefault();
        });


     

        // Sayfa yüklendiğinde toplam ve butonları güncelle
        updateCartTotal();
        updateButtonsState();
        handleBasketSize();
    });
</script>
    
</body>
</html>





    
