    <script>
        function getCartFromCookie() {
            var name = "cart=";
            var decodedCookie = decodeURIComponent(document.cookie);
            var ca = decodedCookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i].trim();
                if (c.indexOf(name) == 0) {
                    try {
                        return JSON.parse(c.substring(name.length, c.length));
                    } catch {
                        return [];
                    }
                }
            }
            return [];
        }

        function updateCartIcon() {
            var cartItems = getCartFromCookie();
            var totalCount = 0;
            cartItems.forEach(function (item) {
                totalCount += item.Quantity;
            });
            var countSpan = document.getElementById('cartItemCount');
            if (countSpan) {
                countSpan.textContent = totalCount;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateCartIcon();
        });
    </script>

    <script>
        function getCookie(name) {
            let v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
            return v ? decodeURIComponent(v[2]) : null;
        }

        function loadCartPreview() {
            let cart = JSON.parse(getCookie('cart') || '[]');
            let container = $('#cartPreview');
            container.empty();

            if (cart.length === 0) {
                container.append('<p>Sepetiniz boş</p>');
                return;
            }

            cart.forEach(item => {
                container.append(`
                        <div class="d-flex align-items-center mb-2">
                            <img src="/${item.ImageUrl}" alt="${item.Name}" style="width:40px; height:40px; object-fit:cover; margin-right:10px; border-radius:4px;" />
                            <div>
                                <p class="mb-0">${item.Name}</p>
                                <small>Adet: ${item.Quantity}</small>
                            </div>
                        </div>
                    `);
            });
        }

        function updateCartIcon() {
            let cart = JSON.parse(getCookie('cart') || '[]');
            let totalCount = 0;
            cart.forEach(item => totalCount += item.Quantity);
            let countSpan = document.getElementById('cartItemCount');
            if (countSpan) {
                countSpan.textContent = totalCount;
            }
        }

        $(document).ready(function () {
            loadCartPreview();
            updateCartIcon();
        });
    </script>


